# --- Core ---
ENVIRONMENT=development
BOT_TOKEN=your-telegram-bot-token
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/earn_bot
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# --- Access control ---
# Comma-separated Telegram user IDs allowed to hit /admin/*
ADMIN_TELEGRAM_IDS=
OWNER_TELEGRAM_ID=0

# --- CORS ---
# Comma-separated list of allowed origins that may call this API from a browser
CORS_ORIGINS=http://localhost:5174

# --- Revenue / payouts ---
USER_REVENUE_SHARE=0.90
MIN_WITHDRAWAL_AMOUNT=1.00
MAX_WITHDRAWAL_AMOUNT=10000.00

# --- Telegram webhook ---
TELEGRAM_WEBHOOK_SECRET=

# --- Postback / offerwall integration ---
POSTBACK_SECRET=
POSTBACK_IP_ALLOWLIST=

# --- Rate limiting ---
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WITHDRAW=5/minute
RATE_LIMIT_POSTBACK=60/minute
RATE_LIMIT_DEFAULT=100/minute

# --- Observability ---
LOG_LEVEL=INFO
LOG_JSON=true
SENTRY_DSN=
